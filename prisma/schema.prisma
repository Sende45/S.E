// prisma/schema.prisma — S.E Holding (boutique = catalogue + WhatsApp)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== UTILISATEURS =====================
model User {
  id         String   @id @default(cuid())
  nom        String
  prenom     String
  email      String   @unique
  motDePasse String
  telephone  String?
  role       Role     @default(CLIENT)
  actif      Boolean  @default(true)
  demandes   Demande[]
  createdAt  DateTime @default(now())
}

enum Role {
  ADMIN
  STAFF
  CLIENT
}

// ===================== SERVICES (traiteur / déco / événementiel) =====================
enum Pole {
  TRAITEUR
  DECORATION
  EVENEMENTIEL
}

model Prestation {
  id            String   @id @default(cuid())
  pole          Pole
  titre         String
  description   String?
  prixIndicatif Int?
  photos        String[]
  actif         Boolean  @default(true)
  createdAt     DateTime @default(now())
}

// Demande de devis (services)
model Demande {
  id              String        @id @default(cuid())
  client          User?         @relation(fields: [clientId], references: [id])
  clientId        String?
  nomContact      String
  telephone       String
  typeEvenement   String
  dateEvenement   DateTime?
  nombreInvites   Int?
  budgetIndicatif Int?
  poles           Pole[]
  message         String?
  statut          StatutDemande @default(NOUVELLE)
  createdAt       DateTime      @default(now())
}

enum StatutDemande {
  NOUVELLE
  DEVIS_ENVOYE
  ACCEPTEE
  REFUSEE
}

// Personnel interne
model Personnel {
  id        String   @id @default(cuid())
  nom       String
  prenom    String
  fonction  String
  telephone String?
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ===================== BOUTIQUE (catalogue simple, commande via WhatsApp) =====================
enum CategorieBoutique {
  VETEMENTS
  CHAUSSURES
  ACCESSOIRES
}

model Produit {
  id            String            @id @default(cuid())
  categorie     CategorieBoutique
  sousCategorie String?
  nom           String
  description   String?
  prix          Int
  photos        String[]
  nouveaute     Boolean           @default(false)
  disponible    Boolean           @default(true)
  actif         Boolean           @default(true)
  createdAt     DateTime          @default(now())
}

// ===================== CONTACT =====================
model MessageContact {
  id        String   @id @default(cuid())
  nom       String
  telephone String?
  email     String?
  sujet     String?
  message   String
  traite    Boolean  @default(false)
  createdAt DateTime @default(now())
}
