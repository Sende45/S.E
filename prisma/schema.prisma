generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

////////////////////////////////////////////////////////////
// UTILISATEURS
////////////////////////////////////////////////////////////

model User {
  id         String   @id @default(cuid())
  nom        String
  prenom     String
  email      String   @unique
  motDePasse String
  telephone  String?
  role       Role     @default(CLIENT)
  actif      Boolean  @default(true)

  demandes   Demande[]

  createdAt  DateTime @default(now())
}

enum Role {
  ADMIN
  STAFF
  CLIENT
}

////////////////////////////////////////////////////////////
// SERVICES
////////////////////////////////////////////////////////////

enum Pole {
  TRAITEUR
  DECORATION
  EVENEMENTIEL
}

model Prestation {
  id            String   @id @default(cuid())

  pole          Pole

  titre         String
  description   String?

  prixIndicatif Int?

  photos        String[]

  actif         Boolean @default(true)

  createdAt     DateTime @default(now())
}

////////////////////////////////////////////////////////////
// DEMANDES
////////////////////////////////////////////////////////////

model Demande {
  id              String   @id @default(cuid())

  client          User?    @relation(fields: [clientId], references: [id])
  clientId        String?

  nomContact      String
  telephone       String

  typeEvenement   String

  dateEvenement   DateTime?

  nombreInvites   Int?

  budgetIndicatif Int?

  poles           Pole[]

  message         String?

  statut          StatutDemande @default(NOUVELLE)

  createdAt       DateTime @default(now())
}

enum StatutDemande {
  NOUVELLE
  DEVIS_ENVOYE
  ACCEPTEE
  REFUSEE
}

////////////////////////////////////////////////////////////
// PERSONNEL
////////////////////////////////////////////////////////////

model Personnel {
  id        String   @id @default(cuid())

  nom       String
  prenom    String

  fonction  String

  telephone String?

  actif     Boolean @default(true)

  createdAt DateTime @default(now())
}

////////////////////////////////////////////////////////////
// BOUTIQUE
////////////////////////////////////////////////////////////

enum CategorieBoutique {
  VETEMENTS
  CHAUSSURES
  ACCESSOIRES
}

model Produit {
  id              String @id @default(cuid())

  categorie       CategorieBoutique?

  univers         Univers @default(MODE)

  rayon           RayonSupermarche?

  sousCategorie   String?

  nom             String

  description     String?

  prix            Int

  photos          String[]

  nouveaute       Boolean @default(false)

  disponible      Boolean @default(true)

  actif           Boolean @default(true)

  createdAt       DateTime @default(now())

  lignesCommande  LigneCommande[]
}

////////////////////////////////////////////////////////////
// CONTACT
////////////////////////////////////////////////////////////

model MessageContact {
  id        String @id @default(cuid())

  nom       String

  telephone String?

  email     String?

  sujet     String?

  message   String

  traite    Boolean @default(false)

  createdAt DateTime @default(now())
}

////////////////////////////////////////////////////////////
// REALISATIONS
////////////////////////////////////////////////////////////

enum CategorieRealisation {
  TRAITEUR
  DECORATION
  EVENEMENTIEL
  VETEMENTS
  CHAUSSURES
  ACCESSOIRES
}

model Realisation {
  id        String @id @default(cuid())

  categorie CategorieRealisation

  titre     String?

  imageUrl  String

  createdAt DateTime @default(now())
}

////////////////////////////////////////////////////////////
// TRAITEUR
////////////////////////////////////////////////////////////

enum TypePlat {
  ENTREE
  PLAT
  DESSERT
  BOISSON
}

model Plat {

  id            String @id @default(cuid())

  nom           String

  description   String?

  type          TypePlat

  prix          Int?

  imageUrl      String?

  disponible    Boolean @default(true)

  actif         Boolean @default(true)

  menus         MenuPlat[]

  createdAt     DateTime @default(now())

  updatedAt     DateTime @updatedAt
}

model MenuSemaine {

  id            String @id @default(cuid())

  numeroSemaine Int

  annee         Int

  debut         DateTime

  fin           DateTime

  actif         Boolean @default(true)

  jours         MenuJour[]

  createdAt     DateTime @default(now())

  updatedAt     DateTime @updatedAt

  @@unique([numeroSemaine, annee])
}

model MenuJour {

  id            String @id @default(cuid())

  menu          MenuSemaine @relation(fields: [menuId], references: [id], onDelete: Cascade)

  menuId        String

  date          DateTime

  jour          String

  actif         Boolean @default(true)

  plats         MenuPlat[]

  createdAt     DateTime @default(now())

  updatedAt     DateTime @updatedAt

  @@unique([menuId, jour])
}

model MenuPlat {

  id            String @id @default(cuid())

  menuJour      MenuJour @relation(fields: [menuJourId], references: [id], onDelete: Cascade)

  menuJourId    String

  plat          Plat @relation(fields: [platId], references: [id])

  platId        String

  ordre         Int @default(0)

  @@unique([menuJourId, platId])
}
////////////////////////////////////////////////////////////
// COMMANDES BOUTIQUE (vraie commande en ligne)
////////////////////////////////////////////////////////////
enum StatutCommande {
  NOUVELLE
  CONFIRMEE
  EN_PREPARATION
  EXPEDIEE
  LIVREE
  ANNULEE
}

enum MethodePaiement {
  LIVRAISON      // paiement à la livraison
  MOBILE_MONEY   // Orange/MTN/Moov/Wave
  ESPECES        // espèces / en boutique
}

model Commande {
  id              String          @id @default(cuid())
  numero          String          @unique
  nomClient       String
  telephone       String
  email           String?
  adresse         String?
  note            String?
  methodePaiement MethodePaiement @default(LIVRAISON)
  statut          StatutCommande  @default(NOUVELLE)
  univers         Univers         @default(MODE)
  modeLivraison   ModeLivraison   @default(RETRAIT)
  fraisLivraison  Int             @default(0)
  livreur         String?
  total           Int
  lignes          LigneCommande[]
  createdAt       DateTime        @default(now())
}

model LigneCommande {
  id           String    @id @default(cuid())
  commande     Commande  @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  commandeId   String
  produit      Produit?  @relation(fields: [produitId], references: [id], onDelete: SetNull)
  produitId    String?
  nomProduit   String
  prixUnitaire Int
  quantite     Int
}

////////////////////////////////////////////////////////////
// SUPERMARCHÉ / ALIMENTATION
////////////////////////////////////////////////////////////
enum Univers {
  MODE
  SUPERMARCHE
}

enum RayonSupermarche {
  ALIMENTATION
  LIQUEURS
  HYGIENE
  MINISHOP
}

enum ModeLivraison {
  RETRAIT
  LIVRAISON
}
